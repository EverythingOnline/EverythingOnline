generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String?
  password  String
  role      String   @default("CUSTOMER")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  addresses Address[]
  orders    Order[]
  vendors   Vendor[]
  actions   AdminAction[] @relation("AdminActions")
  statusChanges OrderStatusHistory[]
}

model Address {
  id        String  @id @default(cuid())
  user      User    @relation(fields: [userId], references: [id])
  userId    String
  line1     String
  line2     String?
  city      String
  postcode  String?
  country   String
  createdAt DateTime @default(now())
  ordersShipping Order[] @relation("ShippingAddress")
}

model Category {
  id               String     @id @default(cuid())
  name             String     @unique
  slug             String     @unique
  parentCategory   Category?  @relation("CategoryParent", fields: [parentCategoryId], references: [id])
  parentCategoryId String?
  subcategories    Category[] @relation("CategoryParent")
  sortOrder        Int        @default(0)
  products         Product[]
  createdAt        DateTime   @default(now())
}

model Vendor {
  id        String      @id @default(cuid())
  name      String
  owner     User        @relation(fields: [ownerId], references: [id])
  ownerId   String
  status    String       @default("PENDING")
  products  Product[]
  createdAt DateTime @default(now())
}

model Product {
  id                String         @id @default(cuid())
  name              String
  slug              String         @unique
  description       String
  brand             String
  price             Float
  originalPrice     Float?
  discount          Int
  rating            Float          @default(0)
  reviewCount       Int            @default(0)
  stock             Int
  lowStockThreshold Int            @default(5)
  isArchived        Boolean        @default(false)
  nutrition         String
  category          Category       @relation(fields: [categoryId], references: [id])
  categoryId        String
  vendor            Vendor?        @relation(fields: [vendorId], references: [id])
  vendorId          String?
  images            String
  productImages     ProductImage[]
  orderItems        OrderItem[]
  createdAt         DateTime       @default(now())
}

model ProductImage {
  id        String   @id @default(cuid())
  product   Product  @relation(fields: [productId], references: [id])
  productId String
  url       String
  altText   String?
  isPrimary Boolean  @default(false)
  position  Int      @default(0)
}

model Order {
  id                 String             @id @default(cuid())
  customerPhone      String
  status             String             @default("PENDING")
  paymentStatus      String             @default("UNPAID")
  paymentMethod      String             @default("CASH")
  paidAt             DateTime?
  confirmedBy        String?
  shippingAddress    Address?           @relation("ShippingAddress", fields: [shippingAddressId], references: [id])
  shippingAddressId  String?
  subtotal           Float
  deliveryFee        Float
  total              Float
  userId             String?
  user               User?              @relation(fields: [userId], references: [id])
  items              OrderItem[]
  payment            Payment?
  statusHistory      OrderStatusHistory[]
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt
}

model OrderItem {
  id         String  @id @default(cuid())
  order      Order   @relation(fields: [orderId], references: [id])
  orderId    String
  product    Product @relation(fields: [productId], references: [id])
  productId  String
  name       String
  sku        String?
  quantity   Int
  unitPrice  Float
  total      Float
  createdAt  DateTime @default(now())
}

model OrderStatusHistory {
  id          String      @id @default(cuid())
  order       Order       @relation(fields: [orderId], references: [id])
  orderId     String
  fromStatus  String
  toStatus    String
  changedBy   User?       @relation(fields: [changedById], references: [id])
  changedById String?
  reason      String?
  createdAt   DateTime    @default(now())
}

model Payment {
  id                String    @id @default(cuid())
  order             Order?    @relation(fields: [orderId], references: [id])
  orderId           String?   @unique
  merchantRequestId String?
  checkoutRequestId String?
  amount            Float?
  method            String?
  reference         String?
  recordedBy       User?     @relation(fields: [recordedById], references: [id])
  recordedById     String?
  recordedAt       DateTime?
  isManual         Boolean   @default(false)
  resultCode        Int
  resultDesc        String
  status            String    @default("PENDING")
  callbackData      String?
  rawPayload        String?
  createdAt         DateTime  @default(now())
}

model AdminAction {
  id         String    @id @default(cuid())
  admin      User      @relation("AdminActions", fields: [adminId], references: [id])
  adminId    String
  actionType String
  entityType String
  entityId   String
  metadata   String?
  createdAt  DateTime  @default(now())
}
