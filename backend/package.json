{
    "name": "everythingonline-backend",
    "version": "0.1.0",
    "private": true,
    "type": "module",
    "scripts": {
        "dev": "nodemon --watch src --exec tsx src/index.ts",
        "start": "node ./dist/index.js",
        "build": "tsc -p tsconfig.json",
        "prisma:migrate": "prisma migrate deploy",
        "prisma:generate": "prisma generate",
        "prisma:db:seed": "tsx --tsconfig tsconfig.seed.json ./prisma/seed.ts"
    },
    "dependencies": {
        "@prisma/client": "^5.3.0",
        "bcrypt": "^5.1.0",
        "cors": "^2.8.5",
        "dotenv": "^16.3.1",
        "express": "^4.18.2",
        "helmet": "^7.0.0",
        "jsonwebtoken": "^9.0.0",
        "prisma": "^5.3.0",
        "socket.io": "^4.8.3"
    },
    "devDependencies": {
        "@types/cors": "^2.8.19",
        "@types/express": "^5.0.6",
        "@types/jsonwebtoken": "^9.0.0",
        "@types/node": "^26.1.2",
        "nodemon": "^2.0.22",
        "tsx": "^3.12.6",
        "typescript": "^5.6.3"
    }
}